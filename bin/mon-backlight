getBrightness() {
    l=$(xbacklight -get)
    # l=$(light -G)
    # roundedbrightness=$(echo "($l + 0.5)/1" | bc)
    # echo "$roundedbrightness"
    echo "$l"
}

report() {
    local brightness=$(getBrightness)

    apptitle="mon-backlight"

    # Arbitrary but unique message id
    msgId="991059"

    iconPath="$HOME/.icons/"
    icon="mon-brightness-off.svg"
    if (($(echo "$brightness > 75" | bc -l))); then
        icon="mon-brightness-high.svg"
    elif (($(echo "$brightness > 35" | bc -l))); then
        icon="mon-brightness-medium.svg"
    elif (($(echo "$brightness > 4" | bc -l))); then
        icon="mon-brightness-low.svg"
    fi

    # Show the volume notification
    dunstify -a $apptitle -u low -i $iconPath$icon -r "$msgId" \
        -h "int:value:$brightness" \
        "Brightness: ${brightness}%"
    # "$(getProgressString $brightness)"
}

getStepSize() {

    local brightness=$(getBrightness)
    local stepSize=5
    if (($(echo "$brightness > $1" | bc -l))); then
        stepSize=5
    else
        stepSize=1
    fi

    echo "$stepSize"
}

case "$1" in
incr)
    xbacklight -inc $(getStepSize 4)
    report
    ;;
decr)
    xbacklight -dec $(getStepSize 5)
    report
    ;;
get)
    getBrightness
    ;;
*)
    echo "Use incr or decr as parameter"
    exit 0
    ;;
esac
